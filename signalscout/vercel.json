{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": ["dashboard/**"]
    }
  },
  "env": {
    "ENVIRONMENT": "public-demo",
    "AI_PROVIDER": "demo",
    "AI_MODEL": "deterministic-demo-v1",
    "ENRICHMENT_PROVIDER": "demo",
    "CRM_PROVIDER": "demo",
    "DATABASE_URL": "sqlite:////tmp/signalscout.db"
  },
  "rewrites": [{"source": "/(.*)", "destination": "/app.py"}]
}