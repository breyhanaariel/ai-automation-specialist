{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": [
        "dashboard/**",
        "data/**"
      ]
    }
  },
  "env": {
    "ENVIRONMENT": "public-demo",
    "LLM_PROVIDER": "demo",
    "LLM_MODEL": "deterministic-demo-v1",
    "DATABASE_URL": "sqlite:////tmp/relaydesk.db",
    "LLM_MAX_RETRIES": "0"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ]
}
