APP_NAME=RelayDesk
ENVIRONMENT=development

# Zero-cost default
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud providers — leave blank unless selected
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Deterministic routing thresholds
CLASSIFICATION_AUTO_THRESHOLD=0.90
CLASSIFICATION_REVIEW_THRESHOLD=0.70

# Free local persistence default
DATABASE_URL=sqlite:///./relaydesk.db
